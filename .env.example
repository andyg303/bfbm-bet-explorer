# PostgreSQL
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=bfbm_bets

# JWT Authentication — CHANGE THIS IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_DAYS=30

# CORS — comma-separated allowed origins (no wildcard in production!)
CORS_ORIGINS=https://yourdomain.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_6MONTH=
STRIPE_PRICE_12MONTH=
FRONTEND_URL=https://yourdomain.com

SMTP_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_xxxxxxxxxxxx
# Email address to receive contact form enquiries (defaults to SMTP_FROM if blank)
CONTACT_TO_EMAIL=hello@yourdomain.com